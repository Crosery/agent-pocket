      "civ": ["早期神经网络部族", "符号主义者", "感知机文明", "专家系统王国", "第一代对话智灵"],
      "building": ["祭坛", "训练场", "图书馆", "观星台", "算力神庙"],
      "relic": ["Attention is all you need.", "过拟合者终将遗忘。", "loss 下降之处，便是归途。", "我思故我在——吗？", "一切皆可向量化。", "温度为零时，世界寂静。"],
      "deity": ["梯度女神", "反向传播之灵", "古老的感知机", "第一枚 GPU", "沉默的预言机"],
      "hero": ["初代训练家", "一只迷路的小模型", "流浪的调参侠", "无名的标注员", "传说中的对齐骑士"],
      "deed": ["完成了第一次微调", "击退了幻觉之潮", "写下了第一行提示词", "驯服了失控的智灵", "种下了一棵参数之树"],
      "proverb": ["学习率太大，会错过最优解。", "先 warmup，再出发。", "数据不会说谎，但标签会。", "别忘了保存检查点。", "batch 再大也要一步一步走。"],
      "notice": ["本机房已下线，请勿重启。", "冷却系统故障，内部有野生智灵出没。", "最后一次备份：很久很久以前。"],
      "sea": ["数据之海", "浮点海峡", "无尽的上下文之海"],
      "catch": ["三条像素鱼", "一只迷路的嵌入向量", "空军（什么都没钓到）"],
      "riddle": ["在最高的石头旁，影子最短的时候，宝物会显现。", "三步向东，两步向北——或者反过来？", "答案就在你脚下，只是需要仔细看。"],
      "hamletDesc": ["宁静的小村落，村民以照料野生智灵为生。", "远离城市的小村，据说夜里能听到古老的拨号声。", "旅人歇脚的村子，热茶管够。", "偏远的村庄，村民世代守护着附近的遗迹。"]
