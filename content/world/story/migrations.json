  "questBaseline": {
    "main": [
      {"text": "妈妈说图灵博士在找你。去镇上的研究所拜访他吧。", "target": "town:origin:lab"},
      {"text": "沿镇子西边的 1 号道路前往开源林镇，挑战代码道馆。", "target": "town:opensource:gym"},
      {"text": "前往东边海岸的像素港，挑战视觉道馆。", "target": "town:pixelport:gym"},
      {"text": "从开源林镇向北，挑战和弦沙城的音律道馆。", "target": "town:chord:gym"},
      {"text": "幻觉团在检索遗都附近的沼泽里污染数据。找到他们的干部，把他们赶走！", "target": "quest:6"},
      {"text": "挑战检索遗都的检索道馆。", "target": "town:retrieval:gym"},
      {"text": "北上火山脚下的熔炉镇，挑战算力道馆。", "target": "town:forge:gym"},
      {"text": "翻越霜脊山口，挑战霜盾城的对齐道馆。", "target": "town:frostshield:gym"},
      {"text": "幻觉团占领了枢纽市的数据塔！登上塔顶，阻止他们的首领。", "target": "town:hub:tower"},
      {"text": "挑战枢纽市的智能体道馆。", "target": "town:hub:gym"},
      {"text": "沿 8 号道路南下高原，挑战衡理镇的推理道馆。", "target": "town:balance:gym"},
      {"text": "集齐了八枚徽章！穿过霜盾城北边的遗迹参道，前往 AGI 圣殿。", "target": "town:agi:temple"},
      {"text": "你成为了新的冠军。圣殿的祭坛深处，似乎有什么在等待着你……", "target": "agi-temple:champion"}
    ],
    "sq-floppy": [
      {"text": "把老王的{item:retro-floppy}交给住在开源林镇的陈工。", "target": "town:opensource:house1"}
    ],
    "sq-dex": [
      {"text": "帮研究助理·小图收服 10 种不同的智灵。", "target": "origin-lab:aide-1"},
      {"text": "继续收集：收服 30 种不同的智灵。", "target": "origin-lab:aide-1"}
    ],
    "sq-photo": [
      {"text": "收服两只{type:vision}系智灵，带给像素港的摄影师·阿光。", "target": "town:pixelport:npc-2"}
    ],
    "sq-chorus": [
      {"text": "收服一只{type:sound}系智灵，带给和弦沙城的合唱团团长。", "target": "town:chord:npc-5"}
    ],
    "sq-antivirus": [
      {"text": "买三瓶{item:antivirus}，交给检索遗都的图书管理员·典藏。", "target": "town:retrieval:house1"}
    ],
    "sq-fan": [
      {"text": "把{item:server-fan}送到枢纽市数据中心的工程师手里。", "target": "town:hub:datacenter"}
    ],
    "sq-snow": [
      {"text": "去霜盾城外的雪原寻找迷路的登山客·大伟。", "target": "quest:8"},
      {"text": "回霜盾城，告诉大伟的妻子他平安无事。", "target": "town:frostshield:house1"}
    ],
    "sq-castaway": [
      {"text": "使用{item:dive-protocol}出海，寻找漂流到东边小岛上的研究员·艾达。", "target": "island:island-1"},
      {"text": "回像素港，向港口调度员报平安。", "target": "town:pixelport:dock-2"}
    ],
    "sq-arena": [
      {"text": "在开源林镇的擂台上击败擂台主·阿源。", "target": "town:opensource:npc-4"}
    ],
    "sq-badges": [
      {"text": "带着两枚徽章去给和弦沙城的老金看看。", "target": "town:chord:house1"},
      {"text": "集齐五枚徽章，再去给老金看看。", "target": "town:chord:house1"},
      {"text": "集齐八枚徽章，让老金开开眼。", "target": "town:chord:house1"}
    ],
    "sq-lostkid": [
      {"text": "衡理镇的小涛跑进了晶核洞窟。去洞里找到他。", "target": "cave-core:3"},
      {"text": "回衡理镇告诉小涛的妈妈。", "target": "town:balance:house1"}
    ],
    "sq-chaos": [
      {"text": "收服一只{type:chaos}系智灵，带给枢纽市的幻觉学者·诺瓦。", "target": "town:hub:house1"}
    ],
    "sq-ruins": [
      {"text": "找到遗迹里的考古队员甲，取回第一份石碑拓片。", "target": "quest:11"},
      {"text": "找到考古队员乙，取回第二份拓片。", "target": "quest:18"},
      {"text": "把两份拓片交给 AGI 圣殿镇的石教授。", "target": "town:agi:house1"}
    ]
  },
