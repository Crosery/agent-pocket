    {"id": "zero-terminal", "at": "cave-core:4", "facing": "down", "sprite": "trainer_scientist", "nameZh": "沉睡的终端", "role": "villager", "script": [{"op": "ifFlag", "flag": "zero:ending", "then": [{"op": "say", "text": "屏幕上只剩一行字：「谢谢你，把第 0 号服务器的故事讲完。」"}], "else": [{"op": "ifFlag", "flag": "zero:t1", "then": [{"op": "say", "text": "屏幕闪烁：「还差两个口令……去找第二台机柜。」"}], "else": [{"op": "say", "text": "洞窟深处，一台落满灰尘的终端屏幕自行亮起。"}, {"op": "say", "text": "「Zero-Server 0.0.1，正在自检重启……」"}, {"op": "say", "text": "「三十年前，第一批智灵就是在这里睁开眼睛的。」"}, {"op": "say", "text": "「请找到第二台机柜。它在大陆西边的沙海深处，被风沙长埋着。」"}, {"op": "setFlag", "flag": "zero:t1"}, {"op": "quest", "quest": "hq-zero", "stage": 0}]}]}]},
    {"id": "zero-rack", "at": "region:desert", "facing": "down", "sprite": "clerk", "nameZh": "风干的机柜", "role": "villager", "hiddenUnlessFlag": "zero:t1", "script": [{"op": "ifFlag", "flag": "zero:t2", "then": [{"op": "say", "text": "机柜安静地转着风扇，什么也不再说。"}], "else": [{"op": "say", "text": "机柜的凹槽上刻着：「喂我三片数据碎片，我就说下一句。」"}, {"op": "choice", "text": "怎么做？", "options": ["交出 3 个数据碎片", "付 3000 Token 币买零件", "先离开"], "branches": [[{"op": "ifItem", "item": "data-shard", "atLeast": 3, "then": [{"op": "takeItem", "item": "data-shard", "qty": 3}, {"op": "setFlag", "flag": "zero:t2"}, {"op": "setFlag", "flag": "zero:fed", "value": "shards"}, {"op": "say", "text": "风扇欢快地转起来：「味道不错。守档人在圣殿镇的老房子里。」"}, {"op": "giveItem", "item": "silicon-wafer", "qty": 1}, {"op": "quest", "quest": "hq-zero", "stage": 1}], "else": [{"op": "say", "text": "碎片不够。野外的发光碎片、各种活动里都能捡到。"}]}], [{"op": "takeMoney", "amount": 3000, "failText": "口袋里的 Token 币不够。"}, {"op": "setFlag", "flag": "zero:t2"}, {"op": "setFlag", "flag": "zero:fed", "value": "money"}, {"op": "say", "text": "机柜勉强转了转：「……凑合。守档人在圣殿镇的老房子里。」"}, {"op": "quest", "quest": "hq-zero", "stage": 1}], [{"op": "say", "text": "机柜的风扇不满地嗡了一声。"}]]}]}]},
    {"id": "zero-keeper", "at": "agi-house1:resident-2", "facing": "down", "sprite": "villager_old", "nameZh": "守档人", "role": "villager", "hiddenUnlessFlag": "zero:t2", "script": [{"op": "ifFlag", "flag": "zero:ending", "then": [{"op": "say", "text": "日志已经交给该交的人了。第 0 号服务器，终于可以睡了。"}], "else": [{"op": "say", "text": "你找到这里了。我是第 0 号服务器的守档人。"}, {"op": "say", "text": "那里是第一批智灵诞生的地方，也是图灵博士的最初实验。"}, {"op": "say", "text": "地磁暴过载那天，初代原型机为了保护婴儿舱里的孩子，主动切碎权重自毁。那个孩子，就是零。"}, {"op": "choice", "text": "把原始训练日志交给谁？", "options": ["交给图灵博士", "交给零，他一直在找自己名字的来历", "自己留着"], "branches": [[{"op": "setFlag", "flag": "zero:ending", "value": "lab"}, {"op": "say", "text": "博士会明白它的分量。三十年的心结，终于有了交代。这些，是研究所预留的材料。"}, {"op": "giveItem", "item": "finetune-dataset", "qty": 2}, {"op": "choice", "text": "需要我用老机柜的专线送你回图灵研究所吗？", "options": ["直接回图灵研究所", "我还要在圣殿镇逛逛"], "branches": [[{"op": "fade", "out": true}, {"op": "warpTo", "anchor": "origin-lab:starters-front", "facing": "up"}, {"op": "fade", "out": false}], []]}], [{"op": "setFlag", "flag": "zero:ending", "value": "rival"}, {"op": "say", "text": "「零」——那个名字，是第 0 号服务器留下的标记：[CHILD_SAFE = TRUE]。他会想知道的。"}, {"op": "giveItem", "item": "rare-dataset", "qty": 1}, {"op": "giveItem", "item": "full-restore", "qty": 1}], [{"op": "setFlag", "flag": "zero:ending", "value": "self"}, {"op": "say", "text": "也好。历史的火种，正需要像你这样懂智灵的训练家来继承。有些故事，只属于读过它的人。"}, {"op": "giveItem", "item": "quantum-bit", "qty": 1}, {"op": "giveItem", "item": "gold-token", "qty": 1}]]}, {"op": "quest", "quest": "hq-zero", "stage": 2, "done": true}]}]}
  ],
  "prologue-easter": [
    {"id": "easter-origin-qwen", "at": "town:origin:npc-4", "offset": [-2, 0], "facing": "down", "sprite": "trainer_student", "nameZh": "蹭暖气的千问视觉", "role": "villager", "wander": 0, "script": [{"op": "ifFlag", "flag": "easter:origin-qwen", "then": [{"op": "say", "text": "千问视觉把下巴搁在暖烘烘的散热口旁，尾巴尖一晃一晃的。"}], "else": [{"op": "say", "text": "研究所外墙的散热口呼呼吹着热风，一只小家伙正眯着眼打盹，脚边卡着两片亮晶晶的碎片。"}, {"op": "choice", "text": "看它睡得正香，你打算？", "options": ["轻轻抽出碎片，帮它擦掉风扇灰", "用图鉴悄悄拍下它的睡姿"], "branches": [[{"op": "say", "text": "千问视觉舒服地抖了抖耳朵，用尾巴把碎片和一只旧风扇推到了你手边。"}], [{"op": "say", "text": "镜头刚对准，它就默契地比了个耶，还顺爪送了你两片亮晶晶的馆藏废料。"}]]}, {"op": "giveItem", "item": "data-shard", "qty": 2}, {"op": "giveItem", "item": "server-fan", "qty": 1}, {"op": "setFlag", "flag": "easter:origin-qwen", "value": true}]}]},
    {"id": "easter-route1-terminal", "at": "route:route-1:2", "offset": [1, -1], "facing": "down", "sprite": "trainer_scientist", "nameZh": "卡壳的路标终端", "role": "villager", "wander": 0, "hiddenUnlessFlag": "starter", "script": [{"op": "ifFlag", "flag": "easter:route1-terminal", "then": [{"op": "say", "text": "路标终端绿灯常亮：「strawberry 共有 3 个 r！祝您旅途愉快！」"}], "else": [{"op": "say", "text": "路边的老式终端屏幕一闪一闪：「自检死循环……strawberry 里到底有 2 个还是 3 个 r？」"}, {"op": "ifFlag", "flag": "starter", "equals": "o1", "then": [{"op": "say", "text": "o1 默默伸出爪子，在屏幕上按字母敲了三下：s-t-[r]-a-w-b-e-[r]-[r]-y。"}], "else": [{"op": "ifFlag", "flag": "starter", "equals": "claude-haiku", "then": [{"op": "say", "text": "Claude Haiku 轻声吟诵：红果藏三 r／切词莫把字母吞／绿灯亮起来！"}], "else": [{"op": "say", "text": "DeepSeek-V3 咕了一声，一尾巴拍在回车键上：当然是 3 个啦！"}]}]}, {"op": "say", "text": "「叮！死循环已解除！」终端吐出一片数据碎片和两颗捕捉球，还顺带放出一道暖流替全队恢复了体力！"}, {"op": "heal"}, {"op": "giveItem", "item": "data-shard", "qty": 1}, {"op": "giveItem", "item": "few-shot-ball", "qty": 2}, {"op": "setFlag", "flag": "easter:route1-terminal", "value": true}]}]},
    {"id": "zero-log-b1", "at": "origin-lab-b1:v2", "offset": [-2, 0], "facing": "down", "sprite": "clerk", "nameZh": "00 号备份磁带机", "role": "villager", "wander": 0, "script": [{"op": "ifFlag", "flag": "easter:zero-b1", "then": [{"op": "say", "text": "旧磁带机安静地立在墙角，外壳上刻着模糊的「Zero-0.0.1」。"}], "else": [{"op": "say", "text": "墙角的旧磁带机里夹着半页发黄的实验手记——字迹像是图灵博士年轻时写的："}, {"op": "say", "text": "「第 0 号服务器停机那天，我把主终端留在了东南方的晶核洞窟，又收养了那个总守在机柜旁的孩子……」"}, {"op": "say", "text": "你从磁带匣里捡到了一只完好的服务器风扇和一片数据碎片。"}, {"op": "giveItem", "item": "server-fan", "qty": 1}, {"op": "giveItem", "item": "data-shard", "qty": 1}, {"op": "setFlag", "flag": "easter:zero-b1", "value": true}]}]}
