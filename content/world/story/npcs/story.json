    {"id": "tp-fan", "at": "agi-temple:npc-1", "sprite": "villager_woman", "nameZh": "冠军的粉丝", "role": "villager", "script": [{"op": "ifFlag", "flag": "champion", "then": [{"op": "say", "text": "你、你就是加冕的新任冠军？！恭喜你！我们见证了一个崭新时代的开端！"}], "else": [{"op": "say", "text": "冠军·启是整片大陆最早探索人机共生的先驱。"}, {"op": "say", "text": "他最常说的一句话是：“算力决定了模型的上限，但人类与智灵的羁绊决定了它的方向。”"}]}], "wander": 1},
