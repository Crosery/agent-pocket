    {"id": "mom", "at": "origin-home:mom", "sprite": "villager_woman", "nameZh": "妈妈", "role": "villager", "script": [{"op": "ifFlag", "flag": "starter", "then": [{"op": "ifFlag", "flag": "ds:done", "then": [{"op": "say", "text": "story.opening.mom.after1", "speaker": "story.cast.mom"}, {"op": "ifCaught", "species": "deepseek-v4", "atLeast": 1, "then": [{"op": "say", "text": "story.opening.mom.afterV4", "speaker": "story.cast.v4", "portrait": "creature:deepseek-v4"}]}], "else": []}, {"op": "ifFlag", "flag": "champion", "then": [{"op": "say", "text": "story.home.champion.m1", "speaker": "story.cast.mom"}, {"op": "say", "text": "story.home.champion.m2", "speaker": "story.cast.mom"}], "else": [{"op": "badgeTiers", "tiers": [{"atLeast": 8, "then": [{"op": "say", "text": "八枚徽章！妈妈在电视上看到你了，你可真是出息了。"}]}, {"atLeast": 1, "then": [{"op": "say", "text": "拿到徽章啦？别光顾着赢，记得按时吃饭、给妈妈打电话。"}]}, {"atLeast": 0, "then": [{"op": "say", "text": "回来啦？让妈妈看看你的智灵……哎呀，跑了一路，累坏了吧。"}]}]}]}, {"op": "heal"}, {"op": "setFlag", "flag": "ob:healed"}, {"op": "say", "text": "好了，精神满满！出门在外要按时吃饭，可别学那些通宵调参的人。"}], "else": [{"op": "ifFlag", "flag": "intro:mom", "then": [{"op": "say", "text": "story.opening.mom.m3", "speaker": "story.cast.mom"}], "else": [{"op": "say", "text": "story.opening.mom.m1", "speaker": "story.cast.mom"}, {"op": "say", "text": "story.opening.mom.m2", "speaker": "story.cast.mom"}, {"op": "say", "text": "story.opening.mom.m3", "speaker": "story.cast.mom"}, {"op": "giveItem", "item": "cache-potion", "qty": 3}, {"op": "giveMoney", "amount": 2000}, {"op": "giveItem", "item": "prompt-ball", "qty": 5}, {"op": "setFlag", "flag": "intro:mom"}, {"op": "teach", "lesson": "objective"}, {"op": "quest", "quest": "main", "stage": 0}]}]}]},
