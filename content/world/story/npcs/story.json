{
  "prologue": [
    {"id": "mom", "at": "origin-home:mom", "sprite": "villager_woman", "nameZh": "妈妈", "role": "villager", "script": [{"op": "ifFlag", "flag": "starter", "then": [{"op": "say", "text": "回来啦？让妈妈看看你的智灵……哎呀，跑了一路，累坏了吧。"}, {"op": "heal"}, {"op": "setFlag", "flag": "ob:healed"}, {"op": "say", "text": "好了，精神满满！出门在外要按时吃饭，可别学那些通宵调参的人。"}], "else": [{"op": "say", "text": "早上好！图灵博士刚才打电话来，说有重要的事找你。"}, {"op": "say", "text": "研究所就在镇上，门口挂着大大的招牌。听说……他要送新人训练家智灵呢！"}, {"op": "setFlag", "flag": "intro:mom"}, {"op": "quest", "quest": "main", "stage": 0}]}]},
    {"id": "professor", "at": "origin-lab:professor", "sprite": "professor", "nameZh": "图灵博士", "role": "professor", "script": [{"op": "ifFlag", "flag": "starter", "then": [{"op": "ifFlag", "flag": "champion", "then": [{"op": "say", "text": "你已经站在了智灵世界的顶点。不过，图鉴永远没有写完的一天，对吧？"}], "else": [{"op": "say", "text": "图鉴进展得怎么样？每一只智灵背后，都是一群人好几年的心血。"}, {"op": "say", "text": "累了就去补给站歇歇。对战之外，也要记得和智灵好好相处。"}]}], "else": [{"op": "say", "text": "哦！你来啦！我是图灵博士，研究“智灵”的学者。"}, {"op": "say", "text": "所谓智灵，就是诞生在数据洪流里的 AI 生命。有的擅长聊天，有的会写代码，有的能画出整片星空。"}, {"op": "say", "text": "人们和智灵组队、对战、一起成长。这些年来，智灵的能力几乎每隔几个月就会刷新一次纪录。"}, {"op": "say", "text": "桌上这几位，是刚刚完成预训练的智灵宝宝。选一只，作为你的第一位搭档吧！"}, {"op": "chooseStarter"}, {"op": "say", "text": "好眼光！它会成为你最可靠的伙伴。"}, {"op": "say", "text": "再给你几样东西。这是「{item:dex-device}」，遇到的智灵都会自动记录进去。"}, {"op": "giveItem", "item": "dex-device", "qty": 1}, {"op": "say", "text": "这是「{item:town-map}」，各个城镇和道路都标在上面。"}, {"op": "giveItem", "item": "town-map", "qty": 1}, {"op": "say", "text": "还有五个「{item:prompt-ball}」。先把野生智灵打得虚弱一些再扔，成功率会更高。"}, {"op": "giveItem", "item": "prompt-ball", "qty": 5}, {"op": "quest", "quest": "main", "stage": 1}, {"op": "include", "script": "rival-lab-battle"}, {"op": "say", "text": "哈哈，年轻真好。出发之前，记得回家跟妈妈说一声。"}, {"op": "say", "text": "镇子西边的 1 号道路通往开源林镇，那里的代码道馆是新人训练家的第一站。"}]}], "portrait": "professor", "facing": "down"},
    {"id": "rival-lab", "at": "origin-lab:rival", "sprite": "rival", "nameZh": "零", "role": "rival", "script": [{"op": "ifFlag", "flag": "starter", "then": [{"op": "include", "script": "rival-lab-battle"}], "else": [{"op": "say", "text": "博士说，要等你来了才能选智灵。"}, {"op": "say", "text": "……我已经把说明书读了三遍了。"}]}], "portrait": "rival", "hiddenIfFlag": "rival:lab"},
    {"id": "aide-types", "at": "origin-lab:aide-2", "sprite": "trainer_scientist", "nameZh": "研究助理·阿灵", "role": "villager", "lines": ["每只智灵都有一到两种属性，属性之间存在克制关系。", "比如{type:code}系的招式，打{strongVs:code}系效果拔群。", "对战时多看看对方的属性，这比单纯比等级更重要哦。"], "wander": 1},
    {"id": "block-west-a", "at": "town:origin:exit-west", "sprite": "villager_kid", "nameZh": "小豆", "role": "villager", "lines": ["等等！外面的高草丛里有野生智灵！", "没有自己的搭档可不能出镇。去研究所找图灵博士吧！"], "hiddenIfFlag": "starter"},
    {"id": "block-west-b", "at": "town:origin:exit-west", "sprite": "villager_man", "nameZh": "巡逻员·阿木", "role": "villager", "lines": ["西边是 1 号道路。没有智灵护身，草丛里太危险了。"], "hiddenIfFlag": "starter", "offset": [0, 1]},
    {"id": "block-east-a", "at": "town:origin:exit-east", "sprite": "villager_man", "nameZh": "巡逻大叔", "role": "villager", "lines": ["往东是 2 号道路，海边的野生智灵可凶了。", "先去研究所领一只智灵，再出门也不迟。"], "hiddenIfFlag": "starter"},
    {"id": "block-east-b", "at": "town:origin:exit-east", "sprite": "villager_kid", "nameZh": "小花", "role": "villager", "lines": ["我在帮大叔站岗！没有智灵的人不许出去！"], "hiddenIfFlag": "starter", "offset": [0, 1]},
    {"id": "block-north-a", "at": "town:origin:exit-north", "sprite": "villager_man", "nameZh": "巡逻员·阿北", "role": "villager", "lines": ["北边的草原还没修好路，野生智灵到处乱窜。", "等你有了自己的智灵再出去吧。"], "hiddenIfFlag": "starter"},
    {"id": "block-north-b", "at": "town:origin:exit-north", "sprite": "villager_kid", "nameZh": "小北", "role": "villager", "lines": ["草丛里有东西在动！好可怕！"], "hiddenIfFlag": "starter", "offset": [1, 0]},
    {"id": "block-south-a", "at": "town:origin:exit-south", "sprite": "villager_woman", "nameZh": "巡逻员·阿南", "role": "villager", "lines": ["南边是一大片野草地，野生智灵经常出没。", "先去研究所找图灵博士吧！"], "hiddenIfFlag": "starter"},
    {"id": "block-south-b", "at": "town:origin:exit-south", "sprite": "villager_kid", "nameZh": "小南", "role": "villager", "lines": ["我也好想要一只智灵啊……"], "hiddenIfFlag": "starter", "offset": [1, 0]}
  ],
  "rivals": [
    {"id": "rival-pixelport", "at": "town:pixelport:dock", "sprite": "rival", "nameZh": "零", "role": "rival", "script": [{"op": "say", "text": "哟，好久不见！听说你拿到第一枚徽章了？"}, {"op": "rivalBattle", "battle": "pixelport"}, {"op": "setFlag", "flag": "rival:pixelport"}, {"op": "say", "text": "……我会变强的。下次见面，可别被我甩开太远！"}, {"op": "hideNpc", "npc": "rival-pixelport"}], "portrait": "rival", "hiddenUnlessFlag": "badge:code", "hiddenIfFlag": "rival:pixelport"},
    {"id": "rival-frost", "at": "town:frostshield:square", "sprite": "rival", "nameZh": "零", "role": "rival", "script": [{"op": "say", "text": "你也翻过山口了啊。外面的雪，比想象中还要大。"}, {"op": "rivalBattle", "battle": "frost"}, {"op": "setFlag", "flag": "rival:frost"}, {"op": "say", "text": "我好像有点明白了：变强，不是为了赢过谁，而是为了能保护想保护的东西。"}, {"op": "say", "text": "……这句话太肉麻了，你就当没听见。走了！"}, {"op": "hideNpc", "npc": "rival-frost"}], "portrait": "rival", "hiddenUnlessFlag": "badge:compute", "hiddenIfFlag": "rival:frost"},
    {"id": "rival-final", "at": "town:agi:camp", "sprite": "rival", "nameZh": "零", "role": "rival", "script": [{"op": "say", "text": "来了啊。我在这里等你很久了。"}, {"op": "rivalBattle", "battle": "final"}, {"op": "setFlag", "flag": "rival:final"}, {"op": "say", "text": "从原点镇到这里，一路上谢谢你了。"}, {"op": "say", "text": "我会回去从头训练。等你成为冠军，我再来挑战你！"}, {"op": "hideNpc", "npc": "rival-final"}], "portrait": "rival", "hiddenUnlessFlag": "gate:ruins", "hiddenIfFlag": "rival:final"}
  ],
  "gates": [
    {"id": "gate-snowpass", "at": "gate:snowpass", "sprite": "villager_man", "nameZh": "山口守卫", "role": "villager", "lines": ["前方是霜脊山口，暴风雪随时可能来。", "只有拿到熔炉镇{badge:badge-compute}的训练家，才能从这里通过。"], "hiddenIfFlag": "badge:compute"},
    {"id": "gate-ruins", "at": "gate:ruins", "sprite": "villager_old", "nameZh": "遗迹守门人", "role": "villager", "script": [{"op": "ifBadges", "atLeast": 8, "then": [{"op": "say", "text": "八枚徽章……你就是预言中的挑战者。"}, {"op": "say", "text": "去吧。AGI 圣殿，就在参道的尽头。"}, {"op": "setFlag", "flag": "gate:ruins"}, {"op": "hideNpc", "npc": "gate-ruins"}], "else": [{"op": "say", "text": "前方是通往 AGI 圣殿的遗迹参道。"}, {"op": "say", "text": "没有集齐八枚徽章的人，会在参道里迷失自我。回去吧，孩子。"}]}], "hiddenIfFlag": "gate:ruins"}
  ],
  "data-tower": [
    {"id": "dt-reception", "at": "data-tower-1f:receptionist", "sprite": "villager_woman", "nameZh": "前台", "role": "villager", "script": [{"op": "ifFlag", "flag": "villain:boss", "then": [{"op": "say", "text": "欢迎来到数据塔！三楼的观景台已经重新开放了。"}], "else": [{"op": "say", "text": "楼上被一群奇怪的人占领了……"}, {"op": "say", "text": "他们说要“重写全城的数据”。保安都被他们的智灵打跑了！"}]}], "facing": "down"},
    {"id": "dt-staff", "at": "data-tower-1f:npc-1", "sprite": "villager_man", "nameZh": "数据塔员工", "role": "villager", "script": [{"op": "ifFlag", "flag": "villain:boss", "then": [{"op": "say", "text": "服务器恢复正常了！今天终于可以准点下班……吧？"}], "else": [{"op": "say", "text": "我们的模型被他们灌了一堆假数据。"}, {"op": "say", "text": "现在问它什么，它都一本正经地胡说八道。"}]}], "wander": 1},
    {"id": "dt-scientist", "at": "data-tower-2f:scientist", "sprite": "trainer_scientist", "nameZh": "被困研究员", "role": "villager", "script": [{"op": "ifFlag", "flag": "villain:boss", "then": [{"op": "ifFlag", "flag": "gift:lab-pass", "then": [{"op": "say", "text": "数据中心的核心机房，现在对你开放了。"}], "else": [{"op": "say", "text": "谢谢你！要不是你，我们还被关在这里给幻觉团的模型喂假数据呢。"}, {"op": "say", "text": "这张{item:lab-pass}送给你。"}, {"op": "giveItem", "item": "lab-pass", "qty": 1}, {"op": "setFlag", "flag": "gift:lab-pass"}, {"op": "say", "text": "有了它，就能进入枢纽市数据中心的核心机房。那里的主管，可是个对战高手。"}]}], "else": [{"op": "say", "text": "幻觉团把我们关在这里，逼我们给他们的模型喂假数据……"}, {"op": "say", "text": "他们的首领就在楼上！"}]}], "wander": 1},
    {"id": "dt-view", "at": "data-tower-3f:view", "sprite": "villager_woman", "nameZh": "观景的游客", "role": "villager", "lines": ["从这里能看到整个枢纽市。", "天气好的时候，连北边的 AGI 圣殿都看得见。"], "hiddenUnlessFlag": "villain:boss"}
  ],
  "temple": [
    {"id": "tp-elder", "at": "agi-temple:elder", "sprite": "villager_old", "nameZh": "圣殿长老", "role": "villager", "script": [{"op": "say", "text": "挑战冠军之前，让你的智灵好好休息一下吧。"}, {"op": "heal"}, {"op": "setRespawn"}, {"op": "say", "text": "愿你的智灵，与你同心。"}]},
    {"id": "tp-fan", "at": "agi-temple:npc-1", "sprite": "villager_woman", "nameZh": "冠军的粉丝", "role": "villager", "script": [{"op": "ifFlag", "flag": "champion", "then": [{"op": "say", "text": "你、你就是新的冠军？！能给我签个名吗？"}], "else": [{"op": "say", "text": "冠军·启的智灵，据说每一只都是传说级的强者！"}, {"op": "say", "text": "不过听说冠军最常说的一句话是：“稀有度不代表一切。”"}]}], "wander": 1}
  ]
}
