    {"id": "rival-pixelport", "at": "town:pixelport:dock", "sprite": "rival", "nameZh": "零", "role": "rival", "script": [{"op": "say", "text": "哟，好久不见！听说你拿到第一枚徽章了？"}, {"op": "rivalBattle", "battle": "pixelport"}, {"op": "setFlag", "flag": "rival:pixelport"}, {"op": "say", "text": "我一路打听，检索遗都那边最近有群怪人在散播假数据。"}, {"op": "say", "text": "什么「幻觉团」……听着就不是好东西。"}, {"op": "say", "text": "一个人追太慢。你打算怎么办？"}, {"op": "choice", "text": "怎么回答零？", "options": ["一起行动，互通情报", "各走各的，决战见真章", "我只想好好抓智灵"], "branches": [[{"op": "setFlag", "flag": "rival:bond", "value": "ally"}, {"op": "say", "text": "好！有消息我就留话，你也别藏着。", "speaker": "零", "portrait": "rival"}, {"op": "say", "text": "这些补给，算见面礼。", "speaker": "零", "portrait": "rival"}, {"op": "giveItem", "item": "super-cache", "qty": 3}, {"op": "giveItem", "item": "token-refill", "qty": 1}], [{"op": "setFlag", "flag": "rival:bond", "value": "rival"}, {"op": "say", "text": "哈！我也是这么想的。谁先到终点，谁说了算。", "speaker": "零", "portrait": "rival"}, {"op": "say", "text": "这颗球借你立个靶子——别输得太难看。", "speaker": "零", "portrait": "rival"}, {"op": "giveMoney", "amount": 3000}, {"op": "giveItem", "item": "rare-ball", "qty": 1}], [{"op": "setFlag", "flag": "rival:bond", "value": "calm"}, {"op": "say", "text": "……随你吧。别走丢就行。", "speaker": "零", "portrait": "rival"}, {"op": "giveItem", "item": "prompt-ball", "qty": 5}]]}, {"op": "hideNpc", "npc": "rival-pixelport"}], "portrait": "rival", "hiddenUnlessFlag": "badge:code", "hiddenIfFlag": "rival:pixelport"},
    {"id": "rival-frost", "at": "town:frostshield:square", "sprite": "rival", "nameZh": "零", "role": "rival", "script": [{"op": "say", "text": "你也翻过山口了啊。外面的雪，比想象中还要大。"}, {"op": "ifFlag", "flag": "rival:bond", "equals": "ally", "then": [{"op": "say", "text": "说好互通情报的。我查到了：幻觉团的老巢在枢纽市的数据塔。", "speaker": "零", "portrait": "rival"}], "else": [{"op": "ifFlag", "flag": "rival:bond", "equals": "rival", "then": [{"op": "say", "text": "还是你先到一步……不过这回，我可不会再让。", "speaker": "零", "portrait": "rival"}], "else": [{"op": "say", "text": "我自己也走了不少弯路。", "speaker": "零", "portrait": "rival"}]}]}, {"op": "rivalBattle", "battle": "frost"}, {"op": "setFlag", "flag": "rival:frost"}, {"op": "say", "text": "我好像有点明白了：变强，不是为了赢过谁，而是为了能保护想保护的东西。"}, {"op": "ifFlag", "flag": "rival:bond", "equals": "ally", "then": [{"op": "say", "text": "所以……这次的情报，你一定用得上。", "speaker": "零", "portrait": "rival"}, {"op": "giveItem", "item": "hyper-cache", "qty": 2}], "else": []}, {"op": "say", "text": "……这句话太肉麻了，你就当没听见。走了！"}, {"op": "hideNpc", "npc": "rival-frost"}], "portrait": "rival", "hiddenUnlessFlag": "badge:compute", "hiddenIfFlag": "rival:frost"},
    {"id": "rival-final", "at": "town:agi:camp", "sprite": "rival", "nameZh": "零", "role": "rival", "script": [{"op": "say", "text": "来了啊。我在这里等你很久了。"}, {"op": "ifFlag", "flag": "rival:bond", "equals": "ally", "then": [{"op": "say", "text": "从像素港说好一起走，到现在，我一次都没后悔过。", "speaker": "零", "portrait": "rival"}], "else": [{"op": "ifFlag", "flag": "rival:bond", "equals": "rival", "then": [{"op": "say", "text": "我们说好决战见真章。今天，就是那一天。", "speaker": "零", "portrait": "rival"}], "else": [{"op": "say", "text": "不管你怎么想，我都当你是对手。", "speaker": "零", "portrait": "rival"}]}]}, {"op": "ifFlag", "flag": "zero:ending", "equals": "rival", "then": [{"op": "say", "text": "还有……谢谢你，把那份原始训练日志带给了我。我的名字，原来是这样来的。", "speaker": "零", "portrait": "rival"}], "else": []}, {"op": "rivalBattle", "battle": "final"}, {"op": "setFlag", "flag": "rival:final"}, {"op": "say", "text": "从原点镇到这里，一路上谢谢你了。"}, {"op": "ifFlag", "flag": "rival:bond", "equals": "ally", "then": [{"op": "say", "text": "这些你拿着。冠军面前，别留任何东西。", "speaker": "零", "portrait": "rival"}, {"op": "giveItem", "item": "full-restore", "qty": 3}], "else": [{"op": "ifFlag", "flag": "rival:bond", "equals": "rival", "then": [{"op": "say", "text": "输了就是输了。这个，算我押的赌注。", "speaker": "零", "portrait": "rival"}, {"op": "giveItem", "item": "rare-dataset", "qty": 1}], "else": []}]}, {"op": "say", "text": "我会回去从头训练。等你成为冠军，我再来挑战你！"}, {"op": "hideNpc", "npc": "rival-final"}], "portrait": "rival", "hiddenUnlessFlag": "gate:ruins", "hiddenIfFlag": "rival:final"}
