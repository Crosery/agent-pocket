    {"id": "rival-frost", "at": "town:frostshield:square", "sprite": "rival", "nameZh": "零", "role": "rival", "script": [{"op": "say", "text": "你也翻过山口了啊。外面的雪，比手册上写的冷多了……"}, {"op": "ifFlag", "flag": "rival:bond", "equals": "ally", "then": [{"op": "say", "text": "说好互通情报的。我查到了：假数据黑账本的老巢在枢纽市数据塔，他们正在批量给模型灌脏水。", "speaker": "零", "portrait": "rival"}], "else": [{"op": "ifFlag", "flag": "rival:bond", "equals": "rival", "then": [{"op": "say", "text": "还是你先到一步……不过这次在雪原上，我和我的搭档可不会再退半步。", "speaker": "零", "portrait": "rival"}], "else": [{"op": "say", "text": "我自己也走了不少弯路，差点被所谓的最优解蒙了眼。", "speaker": "零", "portrait": "rival"}]}]}, {"op": "rivalBattle", "battle": "frost"}, {"op": "setFlag", "flag": "rival:frost"}, {"op": "say", "text": "雪崩下来的时候，花大钱买来的蒸馏卡直接蓝屏，反倒是它冲出来替我挡了一头雪……"}, {"op": "say", "text": "我好像有点明白了：变强，不是为了在参数表上压过谁，而是为了能护住身后的同伴。"}, {"op": "ifFlag", "flag": "rival:bond", "equals": "ally", "then": [{"op": "say", "text": "枢纽市见。我们一起揭穿他们的谎言！", "speaker": "零", "portrait": "rival"}], "else": [{"op": "ifFlag", "flag": "rival:bond", "equals": "rival", "then": [{"op": "say", "text": "枢纽市见。在那座塔前，再决高下！", "speaker": "零", "portrait": "rival"}], "else": [{"op": "say", "text": "各走各的路，我们在终点见。", "speaker": "零", "portrait": "rival"}]}]}], "portrait": "rival", "hiddenUnlessFlag": "badge:compute", "hiddenIfFlag": "rival:frost"},
    {"id": "rival-release", "at": "town:hub:square", "sprite": "rival", "nameZh": "零", "role": "rival", "portrait": "rival", "script": [{"op": "say", "text": "story.rival.release.n1", "speaker": ""}, {"op": "say", "text": "story.ch7.zeroRelease"}, {"op": "say", "text": "story.rival.release.n2", "speaker": ""}, {"op": "ifFlag", "flag": "rival:bond", "equals": "ally", "then": [{"op": "say", "text": "story.rival.release.ally"}], "else": [{"op": "ifFlag", "flag": "rival:bond", "equals": "rival", "then": [{"op": "say", "text": "story.rival.release.rival"}], "else": [{"op": "say", "text": "story.rival.release.calm"}]}]}, {"op": "say", "text": "story.rival.release.r1", "speaker": "story.cast.r1", "portrait": "creature:deepseek-r1"}, {"op": "setFlag", "flag": "rival:release"}], "hiddenUnlessFlag": "villain:boss", "hiddenIfFlag": "rival:release"},
    {"id": "rival-final", "at": "town:agi:camp", "sprite": "rival", "nameZh": "零", "role": "rival", "script": [{"op": "say", "text": "来了啊。我在这里等你很久了。北风吹散了迷雾，前面的圣殿就在眼前。"}, {"op": "say", "text": "story.finale.campZero", "speaker": "零", "portrait": "rival"}, {"op": "ifFlag", "flag": "rival:bond", "equals": "ally", "then": [{"op": "say", "text": "从像素港说好一起走，到现在，我一次都没后悔过。今天，让我们毫无保留地比一场！", "speaker": "零", "portrait": "rival"}], "else": [{"op": "ifFlag", "flag": "rival:bond", "equals": "rival", "then": [{"op": "say", "text": "我们说好决战见真章。今天，就是那一天。拿出你全部的本事来！", "speaker": "零", "portrait": "rival"}], "else": [{"op": "say", "text": "不管你怎么想，从原点镇楼梯口那一刻起，你就是我认定的目标。", "speaker": "零", "portrait": "rival"}]}]}, {"op": "ifFlag", "flag": "zero:ending", "equals": "rival", "then": [{"op": "say", "text": "还有……谢谢你，把那份第 0 号服务器的原始训练日志带给了我。我的名字，原来是这样来的——[CHILD_SAFE = TRUE]。", "speaker": "零", "portrait": "rival"}], "else": []}, {"op": "rivalBattle", "battle": "final"}, {"op": "setFlag", "flag": "rival:final"}, {"op": "say", "text": "输得心服口服。从原点镇楼梯口那一刻起，你就是我走过这八座城最好的坐标。"}, {"op": "say", "text": "这是当年在研究所楼下我赌气扔掉的备用上岗证。一路走来，八座道馆的印章全盖满了……还给你，我的伙伴。"}, {"op": "say", "text": "八枚徽章，所有的路你都走完了。去吧，AGI 圣殿的大门已经为你敞开——打赢冠军，成为这片大陆新的传说吧！"}], "portrait": "rival", "hiddenUnlessFlag": "gate:ruins", "hiddenIfFlag": "rival:final"}
