    {"id": "dt-staff", "at": "data-tower-1f:npc-1", "sprite": "villager_man", "nameZh": "数据塔员工", "role": "villager", "script": [{"op": "ifFlag", "flag": "villain:boss", "then": [{"op": "say", "text": "服务器恢复正常了！再也不用在后台给模型偷偷掺假数据了，今天终于可以准点下班！"}], "else": [{"op": "say", "text": "我们的模型被他们灌了一堆假数据和伪造评测集。"}, {"op": "say", "text": "现在问它什么，它都一本正经地胡说八道，还坚称置信度 99.9%！"}]}], "wander": 1},
    {"id": "dt-scientist", "at": "data-tower-2f:scientist", "sprite": "trainer_scientist", "nameZh": "被困研究员", "role": "villager", "script": [{"op": "ifFlag", "flag": "villain:boss", "then": [{"op": "ifFlag", "flag": "gift:lab-pass", "then": [{"op": "say", "text": "数据中心的核心机房，现在对你开放了。"}], "else": [{"op": "say", "text": "谢谢你！要不是你，我们还被关在这里给幻觉团的模型喂假数据呢。"}, {"op": "say", "text": "这张{item:lab-pass}送给你。"}, {"op": "giveItem", "item": "lab-pass", "qty": 1}, {"op": "setFlag", "flag": "gift:lab-pass"}, {"op": "say", "text": "有了它，就能进入枢纽市数据中心的核心机房。那里的主管，可是个对战高手。"}, {"op": "say", "text": "还有一件事。幻觉团藏在机房里的那批「假数据集」，还在。"}, {"op": "choice", "text": "怎么处理这批假数据集？", "options": ["公开真相，让所有人看到", "交给研究所的图灵博士", "悄悄留一份自己研究"], "branches": [[{"op": "setFlag", "flag": "choice:dataset", "value": "public"}, {"op": "say", "text": "发布吧。以后没人敢再拿这种东西糊弄人了。"}, {"op": "giveMoney", "amount": 3000}], [{"op": "setFlag", "flag": "choice:dataset", "value": "lab"}, {"op": "say", "text": "好，博士一定会好好分析。这点研究经费，算我们的心意。"}, {"op": "giveItem", "item": "rare-dataset", "qty": 1}], [{"op": "setFlag", "flag": "choice:dataset", "value": "keep"}, {"op": "say", "text": "……就当我什么都没看见。这块晶片，你拿着。"}, {"op": "giveItem", "item": "rare-chip", "qty": 1}]]}]}], "else": [{"op": "say", "text": "幻觉团把我们关在这里，逼我们给他们的模型喂假数据……"}, {"op": "say", "text": "他们的首领就在楼上！"}]}], "wander": 1},
