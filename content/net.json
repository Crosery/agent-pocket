{
  "protocol": {
    "wsPath": "/ws",
    "closeCodes": {"shutdown": 1001, "duplicate": 4001, "version": 4002, "flood": 4003, "helloTimeout": 4004, "serverFull": 4005, "slowConsumer": 4006}
  },
  "server": {
    "defaultPort": 8787,
    "maxPayloadBytes": 262144,
    "heartbeatSeconds": 20,
    "helloTimeoutSeconds": 10,
    "onlineSummarySeconds": 5,
    "onlineListMax": 200,
    "maxClients": 2000,
    "maxClientsPerIp": 8,
    "trustProxy": false,
    "snapshotMaxPlayers": 64,
    "maxBufferedBytes": 4194304,
    "skipSnapshotAboveBytes": 524288,
    "emoteSeconds": 3,
    "emoteMaxLen": 8,
    "defaultFacing": "down",
    "boundsSlackTiles": 1,
    "moveSpeedSlack": 1.6,
    "moveToleranceTiles": 2,
    "moveMaxDtSeconds": 1,
    "tradeRequestSeconds": 30,
    "sweepSeconds": 1,
    "closeGraceMs": 2000,
    "rates": {"message": {"count": 80, "perSeconds": 1}, "messageKick": {"count": 400, "perSeconds": 2}, "move": {"count": 40, "perSeconds": 1}, "jump": {"count": 6, "perSeconds": 10}, "emote": {"count": 3, "perSeconds": 3}, "profile": {"count": 6, "perSeconds": 10}, "inspect": {"count": 10, "perSeconds": 10}, "leaderboard": {"count": 5, "perSeconds": 10}, "tradeRequest": {"count": 5, "perSeconds": 30}, "tradeAction": {"count": 30, "perSeconds": 5}, "pvp": {"count": 30, "perSeconds": 5}, "errors": {"count": 10, "perSeconds": 5}},
    "profileLimits": {"badgesMax": 64, "idMaxLen": 64, "maxHp": 99999, "playTimeMaxSec": 1000000000},
    "world": {"maxCoordTiles": 1000000, "pathMarginTiles": 3, "pathMaxNodes": 600, "chunkGen": {"count": 48, "perSeconds": 1}, "retainSeconds": 15, "retainRadiusTiles": 160, "interiorReachTiles": 192, "distanceSlackTiles": 96, "distanceStepTiles": 4}
  },
  "store": {"defaultDir": "data/server", "file": "profiles.json", "debounceMs": 2000, "maxProfiles": 50000, "version": 1},
  "leaderboard": {"size": 50, "sortBy": ["dexCaught", "badges", "pvpWins", "maxDistance"]},
  "client": {"reconnect": {"baseMs": 1000, "maxMs": 30000, "factor": 1.8, "jitter": 0.3}, "pingSeconds": 5, "pingTimeoutSeconds": 15, "rttSmoothing": 0.2, "interpolationDelayMs": 240, "sampleBufferMs": 1500, "snapDistanceTiles": 6, "positionDecimals": 2, "profileDebounceMs": 1500, "leaderboardTimeoutMs": 6000},
  "http": {
    "apiPrefix": "/api/",
    "healthPath": "/api/health",
    "leaderboardPath": "/api/leaderboard",
    "distDir": "dist",
    "publicDir": "public",
    "indexFile": "index.html",
    "hashedAssetPattern": "-[A-Za-z0-9_-]{8}\\.[A-Za-z0-9]+$",
    "immutableMaxAgeSeconds": 31536000,
    "defaultMaxAgeSeconds": 300,
    "compressMinBytes": 1024,
    "compressCacheBytes": 33554432,
    "brotliQuality": 9,
    "gzipLevel": 6,
    "compressible": ["text/", "application/javascript", "application/json", "application/manifest+json", "application/wasm", "image/svg+xml", "model/gltf+json"],
    "defaultMime": "application/octet-stream",
    "mime": {".html": "text/html; charset=utf-8", ".htm": "text/html; charset=utf-8", ".js": "application/javascript; charset=utf-8", ".mjs": "application/javascript; charset=utf-8", ".css": "text/css; charset=utf-8", ".json": "application/json; charset=utf-8", ".map": "application/json; charset=utf-8", ".webmanifest": "application/manifest+json; charset=utf-8", ".txt": "text/plain; charset=utf-8", ".xml": "application/xml; charset=utf-8", ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp", ".avif": "image/avif", ".svg": "image/svg+xml", ".ico": "image/x-icon", ".ktx2": "image/ktx2", ".woff": "font/woff", ".woff2": "font/woff2", ".ttf": "font/ttf", ".otf": "font/otf", ".glb": "model/gltf-binary", ".gltf": "model/gltf+json", ".bin": "application/octet-stream", ".mp3": "audio/mpeg", ".ogg": "audio/ogg", ".wav": "audio/wav", ".m4a": "audio/mp4", ".mp4": "video/mp4", ".webm": "video/webm", ".wasm": "application/wasm"}
  }
}
