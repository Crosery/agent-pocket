      "mutates": false,
      "needs": "live",
      "args": [
        {"name": "frames", "type": "integer", "labelKey": "dev.arg.frames"},
        {"name": "dt", "type": "number", "optional": true, "labelKey": "dev.arg.dt"}
      ]
    },
    "time.scale": {"titleKey": "dev.cmd.timeScale", "group": "time", "mutates": false, "needs": "live", "args": [{"name": "scale", "type": "number", "labelKey": "dev.arg.scale"}]},
    "time.fixed": {"titleKey": "dev.cmd.timeFixed", "group": "time", "mutates": false, "needs": "live", "args": [{"name": "dt", "type": "number", "optional": true, "labelKey": "dev.arg.dtFixed"}]},
    "rng.seed": {"titleKey": "dev.cmd.rngSeed", "group": "rng", "mutates": false, "needs": "live", "args": [{"name": "seed", "type": "integer", "labelKey": "dev.arg.seed"}]}
  },
  "legacy": {"pos": "state.dump(['runtime'])", "tp": "cmd('tp.xy', {x, y, map})", "region": "state.dump(['runtime'])", "gates": "state.dump(['world'])", "places": "cmd('tp.xy')", "discover": "cmd('discover', {place})", "fly": "cmd('fly', {place})", "fog": "state.dump(['save'])", "boss": "cmd('battle.boss')", "distance": "state.dump(['save'])", "clock": "cmd('clock.set', {minutes})", "weather": "cmd('weather.set', {kind})", "roamers": "state.dump(['runtime'])"}
}
