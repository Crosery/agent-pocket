    {"id": "survives-reload", "url": "/?dev=1&scenario=fresh-start&editor-reload", "steps": [{"wait": {"ready": true}}, {"record": {"fileHash": "content/world/layouts/towns.json", "as": "h0"}}, {"cmd": "editor.open"}, {"cmd": "editor.select", "args": {"x": 499, "y": 870}}, {"cmd": "editor.move", "args": {"x": 499, "y": 869}}, {"reload": true}, {"wait": {"ready": true}}, {"cmd": "editor.open"}, {"cmd": "editor.select", "args": {"x": 499, "y": 872}}, {"expect": {"state": ["/runtime/editor/selected/y", 869]}}, {"shot": {"name": "after-reload", "hideDev": false}}, {"cmd": "editor.move", "args": {"x": 499, "y": 868}}, {"record": {"fileHash": "content/world/layouts/towns.json", "as": "h1"}}, {"assert": {"equal": ["h0", "h1"]}}]}
  ]
}
