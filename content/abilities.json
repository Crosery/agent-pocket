[
  {"id": "deep-think", "nameZh": "深度思考", "description": "HP 不足 1/3 时，推理属性招式威力提升 50%。", "effects": [{"on": "powerMul", "mul": 1.5, "if": {"hpBelow": 0.334, "moveTypes": ["logic"]}}]},
