  {"id": "inspiration", "nameZh": "灵感迸发", "description": "HP 不足 1/3 时，创作属性招式威力提升 50%。", "effects": [{"on": "powerMul", "mul": 1.5, "if": {"hpBelow": 0.334, "moveTypes": ["write"]}}]},
  {"id": "long-context", "nameZh": "长上下文", "description": "HP 全满时，受到的伤害减半。", "effects": [{"on": "damageTakenMul", "mul": 0.5, "if": {"hpFull": true}}]},
