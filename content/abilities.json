  {"id": "sniper", "nameZh": "精准视觉", "description": "击中要害时伤害从 1.5 倍提升为 2.25 倍。", "effects": [{"on": "critMul", "value": 2.25}]},
  {"id": "resonance", "nameZh": "共鸣", "description": "音律属性招式威力提升 30%。", "effects": [{"on": "powerMul", "mul": 1.3, "if": {"moveTypes": ["sound"]}}]},
