  {"id": "agentic-loop", "nameZh": "自主循环", "description": "打倒对手后，推理提升 1 级。", "effects": [{"on": "knockOut", "stats": {"atk": 1}}]},
  {"id": "web-search", "nameZh": "联网搜索", "description": "登场时，知识提升 1 级。", "effects": [{"on": "switchIn", "target": "self", "stats": {"spd": 1}}]},
  {"id": "mythic-aura", "nameZh": "神话光环", "description": "受到的伤害降低 25%，能力不会被对手降低。", "effects": [{"on": "damageTakenMul", "mul": 0.75}, {"on": "noStatDrops"}]},
