  {"id": "jailbreak", "nameZh": "越狱", "description": "攻击时无视对手的能力提升与守住。", "effects": [{"on": "ignoreFoeBoosts"}, {"on": "ignoreProtect"}]},
  {"id": "data-hunger", "nameZh": "数据饥渴", "description": "攻击招式造成伤害后，恢复造成伤害的 1/8。", "effects": [{"on": "dealDamage", "drainFraction": 0.125}]},
  {"id": "latency", "nameZh": "高延迟", "description": "总是最后行动，但招式威力提升 30%。", "effects": [{"on": "moveLast"}, {"on": "powerMul", "mul": 1.3, "if": {"moveCategory": "damaging"}}]}
