{
  "_doc": "Every selection rule, weight and threshold used by tools/data/build_species.py. The script is a pure transform: roster research + content tables + these rules -> content/species.json (+ docs/roster.md). Research stats outside their rarity BST band are scaled proportionally to the nearest band edge (noted in docs/roster.md).",
  "sources": {"roster": "docs/research/roster-final.json", "designs": "docs/research/designs.json", "moves": "content/moves.json", "abilities": "content/abilities.json", "items": "content/items.json", "rarities": "content/rarities.json", "types": "content/types.json", "biomes": "content/biomes.json", "config": "content/config.json"},
  "output": "content/species.json",
  "rosterDoc": "docs/roster.md",
  "statKeys": ["hp", "atk", "def", "spa", "spd", "spe"],
  "starters": ["o1", "claude-haiku", "deepseek-v3"],
  "attackPreference": {"_doc": "physical if atk >= spa*(1+margin), special if spa >= atk*(1+margin), else mixed", "margin": 0.1},
  "keywordFields": ["id", "family", "company", "nameEn"],
  "learnset": {
    "minEntries": 10,
    "maxEntries": 16,
    "levelJitter": 1,
    "minSlotLevel": 2,
    "universalTypes": ["chat"],
    "excludeEffects": ["selfFaint"],
    "fixedDamagePower": {"level": 60, "perFixedPoint": 1.5},
    "bandWiden": {"step": 15, "maxSteps": 4},
    "powerBias": {"_doc": "target power = lo + (hi-lo) * clamp(stage + rarity); evolved / rarer forms pick stronger moves inside the same band", "stage": {"1": 0.3, "2": 0.6, "3": 0.85}, "rarity": {"N": -0.15, "R": 0.0, "SR": 0.05, "SSR": 0.1, "UR": 0.2, "MYTHIC": 0.3}},
    "weights": {"power": 2.0, "categoryMatch": 1.5, "signature": 2.5, "fastPriorityBonus": 0.6, "fastStatShare": 0.19, "primaryType": 0.3},
    "penalties": {"recharge": 3.0, "recoil": 1.0, "priority": 0.8, "multiHit": 0.3, "fixedDamage": 0.6, "lowAccuracy": 0.3, "lowAccuracyBelow": 90, "selfDebuff": 0.4},
    "rolePenaltyExempt": {"finisher": ["recharge", "recoil", "selfDebuff", "lowAccuracy"]},
    "level1": {
      "damaging": {"band": [20, 50], "target": 0.65, "types": ["own", "universal"]},
      "status": {"classes": ["debuff", "inflict", "buff"], "_doc": "status moves come from own types first, then learnset.universalTypes"}
    },
    "slots": [
      {"level": 5, "role": "stab", "band": [25, 50]},
      {"level": 9, "role": "status", "classes": ["debuff", "inflict", "focus"]},
      {"level": 13, "role": "stab2", "band": [35, 55]},
      {"level": 17, "role": "coverage", "coverageIndex": 0, "band": [40, 65]},
      {"level": 21, "role": "stab", "band": [55, 72]},
      {"level": 25, "role": "sig", "band": [50, 80]},
      {"level": 30, "role": "status", "classes": ["buff", "focus", "inflict"]},
      {"level": 34, "role": "stab2", "band": [65, 85]},
      {"level": 39, "role": "coverage", "coverageIndex": 1, "band": [65, 95]},
      {"level": 44, "role": "stab", "band": [80, 100]},
      {"level": 50, "role": "status", "classes": ["heal", "protect", "weather", "buff"]},
      {"level": 56, "role": "stab2", "band": [90, 120]},
      {"level": 63, "role": "finisher", "band": [110, 150]}
    ],
    "evolutionMove": {"_doc": "evolved forms learn one STAB move on evolution (level 0), preferring a type the pre-evolution lacked; band picked by evolve level", "level": 0, "bands": [[0, [50, 70]], [20, [60, 80]], [30, [70, 90]], [40, [80, 100]], [48, [90, 120]]]},
    "inheritDropOrder": ["status", "coverage", "sig", "stab2", "stab"],
    "statusScore": {"classRank": 1.5, "ownPrimary": 1.0, "ownSecondary": 0.7, "universal": 0.0, "attackStatFit": 0.8, "speedFit": 0.4, "defenseFit": 0.4, "signature": 2.0},
    "coverageCount": {"N": 1, "R": 1, "SR": 2, "SSR": 2, "UR": 2, "MYTHIC": 2},
    "coverageByCategory": {"llm": ["logic", "write", "search", "code"], "reasoning": ["code", "compute", "search"], "code": ["logic", "agent", "compute"], "agent": ["search", "code", "logic"], "multimodal": ["vision", "sound", "write"], "image": ["write", "motion", "chaos"], "video": ["vision", "sound", "write"], "music": ["write", "chat", "motion"], "audio": ["chat", "write", "motion"], "search": ["logic", "write", "agent"], "embodied": ["compute", "motion", "vision"], "other": ["chat", "chaos", "write"]},
    "coverageByFamily": {"grok": ["chaos", "search"], "grok-companion": ["sound", "write"], "claude": ["write", "safety"], "claude-sonnet": ["logic", "safety"], "gemini": ["vision", "search"], "gemini-pro": ["vision", "search"], "kimi": ["search", "write"], "deepseek": ["code", "logic"], "qwen": ["code", "vision"], "openclaw": ["code", "chat"], "genie": ["vision", "compute"], "marble": ["compute", "agent"], "alpha": ["compute", "code"], "agi": ["agent", "compute"], "neuro": ["sound", "agent"], "character-ai": ["sound", "chaos"], "moltbook": ["agent", "write"], "tripo": ["motion", "write"]},
    "signatureByCategory": {
      "llm": ["context-slam", "chain-of-thought", "system-prompt", "million-token-rush", "token-tackle"],
      "reasoning": ["chain-of-thought", "step-by-step", "long-reasoning", "first-principles", "reflection", "focus-mode", "proof-by-contradiction", "qed"],
      "code": ["hello-world", "debug-strike", "compile-cannon", "force-push", "refactor", "unit-test", "regex-slash", "code-review", "hotfix"],
      "agent": ["function-call", "tool-chain", "plan-execute", "computer-use", "mcp-link", "long-horizon", "multi-agent", "full-auto", "planning-mode", "auto-retry"],
      "multimodal": ["pixel-beam", "object-detect", "voiceprint-wave", "white-noise", "morning-greeting", "super-resolution"],
      "image": ["pixel-beam", "diffusion", "style-transfer", "uhd-cannon", "inpaint", "super-resolution", "ray-trace", "nine-grid", "ink-splash"],
      "video": ["text-to-video", "long-take", "director-cut", "frame-interpolation", "montage", "keyframe", "tracking-shot", "dolly-zoom", "rewind"],
      "music": ["synth-chord", "beat-drop", "symphony-finale", "earworm", "auto-tune", "drum-roll", "rhyme-combo", "sonnet"],
      "audio": ["voiceprint-wave", "voice-clone", "asmr-whisper", "white-noise", "noise-cancel", "sample-steal", "feedback-howl"],
      "search": ["online-search", "deep-research", "rag-recall", "fact-check", "web-crawl", "rerank", "full-index", "knowledge-graph", "keyword-jab"],
      "embodied": ["autopilot", "plan-execute", "depth-map", "object-detect", "tensor-tackle", "heat-sink-slam", "computer-use"],
      "other": []
    },
    "signatureByType": {"open": ["hug", "community-fork", "pull-request", "open-license", "distill-strike", "community-power"], "search": ["online-search", "rag-recall", "fact-check", "web-crawl"], "agent": ["function-call", "tool-chain", "mcp-link", "plan-execute"], "sound": ["synth-chord", "voiceprint-wave", "auto-tune"], "motion": ["text-to-video", "long-take", "keyframe"], "vision": ["diffusion", "pixel-beam", "super-resolution"], "safety": ["constitution", "harmless-light", "alignment-shield"], "chaos": ["confabulate", "hallucination-fog", "fake-citation"]},
    "signatureByKeyword": [
      {"match": "(^|[^a-z])(flash|lite|mini(?!max)|nano|haiku|turbo|7b)", "moves": ["quick-reply", "quick-deduce", "cache-hit", "frame-skip", "autopilot", "quantize", "bullet-time"]},
      {"match": "(^|[^a-z])(o1|r1|thinking|reason|think)", "moves": ["chain-of-thought", "long-reasoning", "step-by-step", "reflection"]},
      {"match": "anthropic", "moves": ["constitution", "harmless-light", "alignment-shield", "superalignment"]},
      {"match": "grok", "moves": ["sarcasm", "hot-take", "trending-blast", "rogue-strike"]},
      {"match": "(character|grok-ani|neuro|companion)", "moves": ["persona-shift", "emoji-barrage", "small-talk", "flattery"]},
      {"match": "(deepseek|qwen3|kimi-k|mimo-v2|longcat|gpt-oss|llama-4)", "moves": ["moe-burst", "distill-strike"]},
      {"match": "(perplexity|notebooklm|comet|yuanbao)", "moves": ["deep-research", "online-search", "fact-check"]},
      {"match": "(codex|copilot|cursor|claude-code|windsurf|trae|qoder|kiro|opencode)", "moves": ["compile-cannon", "force-push", "debug-strike", "refactor"]},
      {"match": "(eleven|voice|audio|live)", "moves": ["voice-clone", "voiceprint-wave", "asmr-whisper"]},
      {"match": "(unitree|optimus|figure|agibot|robotics|pi-zero)", "moves": ["autopilot", "heat-sink-slam", "depth-map", "object-detect"]},
      {"match": "(gpt-35|chatgpt|doubao-app|qwen-app)", "moves": ["morning-greeting", "chatter-storm", "small-talk"]},
      {"match": "(mythos|\\bagi\\b|\\balpha\\b)", "moves": ["superalignment", "first-principles", "long-reasoning"]}
    ],
    "inheritReplaceGap": 6
  },
  "abilities": {
    "max": 2,
    "secondMinScore": 2.0,
    "_doc": "each rule adds score to an ability when ALL its conditions hold; top-scoring abilities win, ties broken by rule order",
    "rules": [
      {"ability": "mythic-aura", "score": 10, "if": {"rarity": ["MYTHIC"]}},
      {"ability": "benchmark-ace", "score": 3.6, "if": {"rarity": ["UR"], "capabilityMin": 90}},
      {"ability": "scaling-law", "score": 3.6, "if": {"rarity": ["UR"], "capabilityMax": 89.99}},
      {"ability": "long-context", "score": 3.2, "if": {"statShareMin": {"hp": 0.205}}},
      {"ability": "deep-think", "score": 3.0, "if": {"category": ["reasoning"]}},
      {"ability": "deep-think", "score": 2.0, "if": {"types": ["logic"]}},
      {"ability": "hot-compile", "score": 3.0, "if": {"category": ["code"]}},
      {"ability": "hot-compile", "score": 2.0, "if": {"types": ["code"]}},
      {"ability": "inspiration", "score": 2.4, "if": {"types": ["write"]}},
      {"ability": "quantized", "score": 3.4, "if": {"idMatch": "(^|-)(flash|lite|mini(?!max)|nano|haiku|turbo|7b)"}},
      {"ability": "quantized", "score": 2.0, "if": {"keywords": "(^|[^a-z])(flash|lite|mini(?!max)|nano|turbo)"}},
      {"ability": "turbo", "score": 2.3, "if": {"topStat": ["spe"]}},
      {"ability": "open-weights", "score": 2.5, "if": {"types": ["open"]}},
      {"ability": "guardrails", "score": 2.6, "if": {"types": ["safety"]}},
      {"ability": "rlhf", "score": 2.2, "if": {"types": ["safety"], "keywords": "(anthropic|openai|google|apple)"}},
      {"ability": "firewall", "score": 2.8, "if": {"types": ["safety"], "topStat": ["def", "spd"]}},
      {"ability": "safety-filter", "score": 3.1, "if": {"types": ["safety"], "category": ["multimodal"]}},
      {"ability": "sandbox", "score": 3.5, "if": {"keywords": "mythos"}},
      {"ability": "retrieval", "score": 2.5, "if": {"types": ["search"]}},
      {"ability": "web-search", "score": 3.0, "if": {"category": ["search"]}},
      {"ability": "web-search", "score": 2.2, "if": {"keywords": "(perplexity|notebooklm|yuanbao|comet|kimi-chat|ernie-bot)"}},
      {"ability": "multimodal", "score": 3.0, "if": {"category": ["multimodal"]}},
      {"ability": "agentic-loop", "score": 3.0, "if": {"category": ["agent"]}},
      {"ability": "tool-use", "score": 2.5, "if": {"types": ["agent"]}},
      {"ability": "sniper", "score": 3.0, "if": {"category": ["image"]}},
      {"ability": "render-farm", "score": 2.0, "if": {"category": ["image"]}},
      {"ability": "render-farm", "score": 3.0, "if": {"category": ["video"]}},
      {"ability": "render-farm", "score": 2.0, "if": {"types": ["motion"], "category": ["other", "embodied"]}},
      {"ability": "sniper", "score": 2.0, "if": {"types": ["vision"], "category": ["embodied", "other", "multimodal"]}},
      {"ability": "resonance", "score": 3.0, "if": {"types": ["sound"]}},
      {"ability": "hallucinate", "score": 3.0, "if": {"types": ["chaos"]}},
      {"ability": "jailbreak", "score": 3.2, "if": {"keywords": "grok", "types": ["chaos"]}},
      {"ability": "mixture-of-experts", "score": 3.1, "if": {"keywords": "(grok-1|deepseek-v3|deepseek-v4|gpt-oss|llama-4|qwen3|qwen-flash|kimi-k2|kimi-k3|glm-4-5|glm-5|minimax-m2|longcat|mimo-v2|bailing|step-5|hy3|ernie-4-5)"}},
      {"ability": "distilled", "score": 3.0, "if": {"keywords": "(phi-4|mimo-7b|minicpm|gemma|deepseek-r1|mistral-7b)"}},
      {"ability": "lightweight", "score": 3.3, "if": {"keywords": "(apple-afm|minicpm|gemma|phi-4|sd-1-5)"}},
      {"ability": "lightweight", "score": 1.5, "if": {"rarity": ["N"]}},
      {"ability": "latency", "score": 2.6, "if": {"statShareMax": {"spe": 0.1}}},
      {"ability": "aura", "score": 2.6, "if": {"hotnessMin": 95}},
      {"ability": "self-correct", "score": 2.1, "if": {"category": ["reasoning"]}},
      {"ability": "data-hunger", "score": 2.4, "if": {"keywords": "(meta|moltbook)"}},
      {"ability": "data-hunger", "score": 1.4, "if": {"types": ["search"]}},
