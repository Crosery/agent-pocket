      {"ability": "context-cache", "score": 2.0, "if": {"types": ["chat"]}}
    ],
    "fallbackByType": {"chat": "context-cache", "logic": "deep-think", "code": "hot-compile", "write": "inspiration", "vision": "sniper", "motion": "render-farm", "sound": "resonance", "search": "retrieval", "agent": "tool-use", "open": "open-weights", "compute": "overclocked", "chaos": "hallucinate", "safety": "guardrails"}
  },
  "teachable": {
    "min": 4,
    "maxByRarity": {"N": 6, "R": 8, "SR": 10, "SSR": 11, "UR": 12, "MYTHIC": 12},
    "excludeLearnset": true,
    "compatByCategory": {"llm": ["chat", "logic", "write"], "reasoning": ["logic", "compute", "search"], "code": ["code", "logic", "compute"], "agent": ["agent", "search", "code"], "multimodal": ["vision", "sound", "chat"], "image": ["vision", "write"], "video": ["motion", "vision", "sound"], "music": ["sound", "write"], "audio": ["sound", "chat"], "search": ["search", "write", "logic"], "embodied": ["agent", "compute", "motion"], "other": ["chat", "chaos", "write"]},
    "scores": {"ownPrimary": 3.2, "ownSecondary": 3.0, "compat": 1.5, "categoryMatch": 1.0, "status": 0.4, "coverage": 0.6, "coverageOnly": 1.2},
    "includeCoverageTypes": true
  },
  "catchRate": {"_doc": "t = stageT*stageWeight + bstPosInBand*bstWeight; catchRate = hi - t*(hi-lo) (rarity band from content/rarities.json)", "stageT": {"1": 0.15, "2": 0.55, "3": 0.9}, "stageWeight": 0.7, "bstWeight": 0.3},
  "baseExp": {"_doc": "baseExp = round(BST * max(perBstByStage[stage], minPerBstByRarity[rarity]))", "perBstByStage": {"1": 0.2, "2": 0.33, "3": 0.45}, "minPerBstByRarity": {"N": 0.18, "R": 0.2, "SR": 0.24, "SSR": 0.3, "UR": 0.42, "MYTHIC": 0.5}},
  "growth": {
    "_doc": "growth is family-wide (exp persists through evolution) and keyed by the family's highest rarity; a [low, high] pair picks by that member's BST position in its band",
    "basis": "familyMaxRarity",
    "byRarity": {"N": ["fast", "fast"], "R": ["fast", "medium"], "SR": "medium", "SSR": "slow", "UR": "slow", "MYTHIC": "slow"},
    "split": 0.5
  },
  "size": {
    "_doc": "size = categoryBase + stageAdd + rarityAdd, clamped and rounded",
    "categoryBase": {"llm": 0.85, "reasoning": 0.85, "code": 0.8, "agent": 0.9, "multimodal": 0.9, "image": 0.8, "video": 0.95, "music": 0.8, "audio": 0.75, "search": 0.85, "embodied": 1.25, "other": 0.9},
    "stageAdd": {"1": 0.0, "2": 0.25, "3": 0.5},
    "rarityAdd": {"N": -0.1, "R": 0.0, "SR": 0.1, "SSR": 0.2, "UR": 0.35, "MYTHIC": 0.7},
    "min": 0.7,
    "max": 2.2,
    "round": 2
  },
  "rosterDocLabels": {"title": "# 智灵口袋 · 图鉴总表", "generated": "> 由 `python3 tools/data/build_species.py` 根据 `docs/research/roster-final.json` + `tools/data/species_rules.json` 生成，勿手改。", "summary": "共 {n} 只，{families} 个家族；{starters} 只初始伙伴。", "starterTitle": "## 初始伙伴三角", "starterIntro": "三只初始伙伴均为 1 阶，属性构成循环克制（攻击方 → 防守方 = 2×）：", "starterRow": "- **{a}**（{at}）克制 **{b}**（{bt}）", "starterHeader": "| 初始伙伴 | 公司 | 属性 | 稀有度 | BST | 进化链 |", "rarityTitle": "## 稀有度分布", "rarityHeader": "| 稀有度 | 名称 | 数量 | BST 区间 | 捕获率区间 |", "bstNotesTitle": "## BST 校正", "bstNotesNone": "全部研究数据的 BST 均在稀有度区间内，未做缩放。", "tableTitle": "## 全图鉴", "tableHeader": "| # | 名称 | 公司 | 国家 | 属性 | 稀有度 | BST | 进化 |", "evoTo": "→ {name} Lv{level}", "evoFrom": "← {name}", "evoNone": "—", "typeSep": "/", "listSep": "；", "chainStep": "{name} (Lv{level})", "chainSep": " → ", "range": "{lo}–{hi}"}
}
