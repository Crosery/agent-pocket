{
  "name": "agent-pocket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Pocket · 智灵口袋 — HD-2D open-world pixel creature-collecting game where the creatures are today's AIs. Multiplayer, pure web.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch src/server/index.ts",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
