{
  "about": "Render + post style for the hand-built chibi cast (tools/blender/chibi.py, tools/chibi_post.py). Units: Blender metres; pixel sizes are at the final 64px cell.",
  "outDir": "assets_src/raw/chibi",
  "body": {"headR": 0.57, "headZ": 1.27},
  "render": {"size": 256, "orthoScale": 2.34, "targetZ": 0.97, "distance": 8, "depthNear": 7.0, "depthFar": 9.0, "elevationDeg": 12},
  "frames": {"idle": 8, "walk": 8},
  "sway": {"lag": 0.9},
  "shading": {"light": [-0.55, -0.6, 0.75], "threshold": 0.18, "highlightThreshold": 0.82, "shade": {"hueTarget": 0.7, "hueShift": 0.12, "sat": 1.12, "satAdd": 0.04, "val": 0.76}, "highlight": {"hueTarget": 0.14, "hueShift": 0.06, "sat": 0.82, "val": 1.12, "valAdd": 0.03}, "glossy": ["hat", "visor", "lens", "shoes", "armor"]},
  "face": {
    "anchors": {"eyeL": [0.38, -0.16], "eyeR": [-0.38, -0.16], "mouth": [0.0, -0.52], "blushL": [0.6, -0.38], "blushR": [-0.6, -0.38]},
    "minFacing": 0.25
  },
  "post": {
    "cell": 64,
    "scale": 4,
    "soleRow": 61,
    "outline": {"darken": 0.42, "hueTarget": 0.72, "hueShift": 0.1, "minAlphaNeighbours": 1},
    "innerLine": {
      "depthGap": 0.006,
      "darken": 0.62,
      "skipKinds": [["hair", "hair"], ["skin", "skin"], ["torso", "torso"], ["leg", "leg"], ["arm", "arm"], ["face", "skin"]]
    },
    "blinkFrames": {"idle": [5]},
    "review": {"scale": 4, "background": "#4F6B4A"}
  },
  "eyes": {
    "front": {"rows": [".LLLL.", "LKKKKL", "KWWKIK", "KWWIIK", "KIIIIK", "KIHHIK", ".KHHK."], "closed": ["......", "......", "......", "LLLLLL", ".L..L.", "......", "......"]},
    "side": {"rows": ["LLL.", "KKKL", "WWIK", "WIIK", "IIIK", "HHIK", ".HK."], "closed": ["....", "....", "....", "LLLL", "....", "....", "...."]},
    "keys": {"L": "lash", "I": "iris", "W": "#FFFFFF", "H": "irisLight", "K": "irisDark"}
  },
  "mouths": {"smile": ["M..M", ".MM."], "open": [".M.", "MTM", ".M."], "flat": ["MM"], "side": ["M"], "keys": {"M": "mouth", "T": "tongue"}, "grin": ["MMMM", ".TT."]},
  "blush": {"rows": ["BBB"], "keys": {"B": "blush"}},
  "faceColors": {"lash": "#2A1A20", "mouth": "#7A2E34", "tongue": "#E07A86", "blush": "#F3A1A6"},
  "glasses": {"front": [".GGGGGG.", "G......G", "G......G", "G......G", "G......G", "G......G", "G......G", ".GGGGGG."], "side": ["GGGG.", "....G", "....G", "....G", "....G", "....G", "....G", "GGGG."], "keys": {"G": "glasses"}}
}
